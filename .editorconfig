# ============================================================================
# ГЛОБАЛЬНЫЕ НАСТРОЙКИ И ПАРАМЕТРЫ ФАЙЛОВ
# ============================================================================
# EditorConfig не будет искать настройки выше него.
root = true
[*]
charset = utf-8         # Кодировка файлов по умолчанию.
indent_style = space    # Для отступов используются пробелы, а не символы табуляции.
indent_size = 4         # Размер отступа по умолчанию — 4 пробела.

# --- ФАЙЛЫ ПРОЕКТОВ VISUAL STUDIO ---
[*.csproj]
indent_size = 2
# --- XML И ФАЙЛЫ КОНФИГУРАЦИИ ---
[*.{xml,config,props,targets}]
indent_size = 2
# --- JSON ---
[*.json]
indent_size = 2

# --- ИСХОДНЫЙ КОД ПРОЕКТА ---
[*.cs]
indent_size = 4                     # Размер отступа в исходном коде проекта — 4 пробела.
insert_final_newline = true         # В конце файла должен присутствовать завершающий символ перевода строки.
charset = utf-8-bom                 # Для исходного кода используется UTF-8 с BOM.
trim_trailing_whitespace = true     # Пробелы и табуляция в конце строк удаляются.

# --- УРОВЕНЬ СТРОГОСТИ АНАЛИЗАТОРОВ ---
[*.cs]
dotnet_analyzer_diagnostic.severity = warning   # Уровень по умолчанию для диагностик анализаторов .NET в исходном коде проекта.

# --- СТИЛЬ .NET: КВАЛИФИКАТОРЫ И ИМЕНА ТИПОВ ---
[*.cs]
dotnet_style_qualification_for_field = false:error                        # Не требовать this. при обращении к полям.
dotnet_style_qualification_for_property = false:error                     # Не требовать this. при обращении к свойствам.
dotnet_style_qualification_for_method = false:error                       # Не требовать this. при вызове методов.
dotnet_style_qualification_for_event = false:error                        # Не требовать this. при обращении к событиям.
dotnet_style_predefined_type_for_locals_parameters_members = true:error   # Предпочитать ключевые слова языка именам типов .NET при объявлении локальных переменных, параметров и членов.
dotnet_style_predefined_type_for_member_access = true:error               # Предпочитать ключевые слова языка именам типов .NET при обращении к статическим членам типов.

# --- СТИЛЬ .NET: МОДИФИКАТОРЫ ДОСТУПА И ПОРЯДОК МОДИФИКАТОРОВ ---
dotnet_style_require_accessibility_modifiers = always:error   # Требовать явный модификатор доступности у объявлений.
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning # Предпочтительный порядок модификаторов в C#.
dotnet_style_readonly_field = true:error                      # Предпочитать readonly для полей, значение которых не меняется после инициализации.

# --- СТИЛЬ .NET: СКОБКИ ---
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:warning # Использовать скобки в арифметических выражениях, когда они делают порядок вычислений нагляднее.
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:warning # Использовать скобки в операциях сравнения, когда они повышают ясность выражения.
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:warning      # Использовать скобки в остальных бинарных выражениях, когда это улучшает читаемость.
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:warning           # Не добавлять скобки вокруг выражений, если без них смысл остаётся однозначным.

# --- ПЕРЕОПРЕДЕЛЕНИЕ ДИАГНОСТИК КОМПИЛЯТОРА ---
[*.cs]
dotnet_diagnostic.CS0067.severity = warning    # Для C# вне src/Assets/Game отключить предупреждение о событии, которое нигде не используется.
dotnet_diagnostic.CS0618.severity = warning    # Для C# вне src/Assets/Game отключить предупреждение об использовании устаревшего API.
[src/Assets/*.cs]
dotnet_diagnostic.CS0067.severity = error      # В исходном коде игры считать неиспользуемые события ошибкой.
dotnet_diagnostic.CS0618.severity = error      # В исходном коде игры считать использование устаревшего API ошибкой.
dotnet_diagnostic.UNT0008.severity = error     # Запрещать условный доступ ?. к объектам Unity: Unity переопределяет сравнение с null, поэтому такая конструкция может работать некорректно.
dotnet_diagnostic.UNT0007.severity = error     # Запрещать оператор ?? для объектов Unity: Unity переопределяет сравнение с null, поэтому стандартная семантика оператора не подходит.
dotnet_analyzer_diagnostic.category-Style.severity = error  # Все диагностики категории Style в исходном коде игры повышаются до уровня ошибки.

# ============================================================================
# СТИЛЬ .NET: ГЛОБАЛЬНЫЕ ПРАВИЛА БЕЗ СЕКЦИИ (ПРИМЕНЯЮТСЯ КО ВСЕМ ФАЙЛАМ)
# ============================================================================
[*]
# --- СТИЛЬ .NET: ИНИЦИАЛИЗАЦИЯ И ВЫРАЖЕНИЯ ---
dotnet_style_object_initializer = true:warning  # Предпочитать инициализаторы объектов вместо последовательного присваивания свойств после создания объекта.
dotnet_style_collection_initializer = true:warning  # Предпочитать инициализаторы коллекций.
dotnet_style_explicit_tuple_names = true:warning  # Задавать явные имена элементам кортежей, если это повышает понятность кода.
dotnet_style_prefer_inferred_tuple_names = true:warning  # Предпочитать вывод имён элементов кортежа из имён выражений.
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning  # Предпочитать вывод имён свойств анонимного типа из имён выражений.
dotnet_style_prefer_auto_properties = true:warning  # Предпочитать автоматически реализуемые свойства, если дополнительная логика доступа не нужна.
dotnet_style_prefer_conditional_expression_over_assignment = false:warning  # Не заменять присваивание условным выражением только ради сокращения записи.
dotnet_style_prefer_conditional_expression_over_return = false:warning  # Не заменять конструкцию return условным выражением только ради сокращения записи.
dotnet_style_prefer_compound_assignment = true:warning  # Предпочитать составные операторы присваивания, например += вместо x = x + ... .
dotnet_style_prefer_simplified_interpolation = true:warning  # Предпочитать упрощённую интерполяцию строк, если она эквивалентна исходной записи.
dotnet_style_prefer_simplified_boolean_expressions = true:warning  # Предпочитать упрощённые логические выражения без лишних сравнений с true или false.

# --- СТИЛЬ .NET: ПРОВЕРКА НА NULL ---
dotnet_style_coalesce_expression = true:warning  # Предпочитать оператор объединения с NULL (??), когда он заменяет явную проверку на null.
dotnet_style_null_propagation = true:warning  # Предпочитать условный доступ к члену (?.), когда он заменяет проверку на null.
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning  # Предпочитать проверку `is null` вместо вызова ReferenceEquals для проверки на null.

# --- СТИЛЬ .NET: ДОПОЛНИТЕЛЬНЫЕ ПРАВИЛА ---
dotnet_style_operator_placement_when_wrapping = beginning_of_line  # При переносе выражения на новую строку размещать оператор в начале строки.
csharp_style_prefer_null_check_over_type_check = true:warning  # Предпочитать проверку на null вместо проверки типа, если проверка типа используется только для выявления null.
csharp_style_prefer_method_group_conversion = true:warning  # Предпочитать передачу группы методов вместо избыточного лямбда-выражения.
csharp_style_prefer_top_level_statements = true:error  # Предпочитать инструкции верхнего уровня, когда структура программы это допускает.
csharp_style_prefer_local_over_anonymous_function = true:warning  # Предпочитать локальную функцию анонимной функции, если это делает код понятнее.
csharp_style_prefer_tuple_swap = true:warning  # Предпочитать обмен значениями кортежа вместо временной переменной.
csharp_style_prefer_utf8_string_literals = true:warning  # Предпочитать строковые литералы UTF-8, когда это подходит для работы с данными UTF-8.
csharp_style_allow_embedded_statements_on_same_line_experimental = true:warning  # Разрешать размещать вложенную инструкцию на одной строке с управляющей конструкцией. Экспериментальная настройка.
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = true:warning  # Разрешать пустую строку после двоеточия в инициализаторе конструктора. Экспериментальная настройка.
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = true:warning  # Разрешать пустые строки между соседними закрывающими и открывающими фигурными скобками. Экспериментальная настройка.
csharp_style_prefer_extended_property_pattern = true:warning  # Предпочитать расширенный шаблон свойств, когда он позволяет компактнее записать проверку вложенных свойств.

# --- СТИЛЬ C#: НЕЯВНО ТИПИЗИРОВАННЫЕ ПЕРЕМЕННЫЕ VAR ---
[*.cs]
csharp_style_var_for_built_in_types = true:error      # Предпочитать var при объявлении переменных встроенных типов (int, string и т. п.).
csharp_style_var_when_type_is_apparent = true:error   # Предпочитать var, когда тип очевиден из правой части выражения.
csharp_style_var_elsewhere = true:error               # Предпочитать var и в остальных случаях.

# --- СТИЛЬ C#: ВЫРАЖЕНИЯ С ТЕЛОМ-ВЫРАЖЕНИЕМ ---
csharp_style_expression_bodied_methods = true:warning           # Предпочитать тело-выражение для методов, когда тело состоит из одного выражения.
csharp_style_expression_bodied_constructors = true:warning      # Предпочитать тело-выражение для конструкторов, когда это возможно.
csharp_style_expression_bodied_operators = true:warning         # Предпочитать тело-выражение для перегруженных операторов.
csharp_style_expression_bodied_properties = true:warning        # Предпочитать тело-выражение для свойств.
csharp_style_expression_bodied_indexers = true:warning          # Предпочитать тело-выражение для индексаторов.
csharp_style_expression_bodied_accessors = true:warning         # Предпочитать тело-выражение для методов доступа свойств и индексаторов.
csharp_style_expression_bodied_lambdas = true:warning           # Предпочитать тело-выражение для лямбда-выражений.
csharp_style_expression_bodied_local_functions = true:warning   # Предпочитать тело-выражение для локальных функций.

# --- СТИЛЬ C#: СОПОСТАВЛЕНИЕ С ОБРАЗЦОМ (PATTERN MATCHING) ---
csharp_style_pattern_matching_over_is_with_cast_check = true:warning    # Предпочитать сопоставление с образцом вместо проверки is с последующим приведением типа.
csharp_style_pattern_matching_over_as_with_null_check = true:warning    # Предпочитать сопоставление с образцом вместо as с последующей проверкой на null.
csharp_style_prefer_switch_expression = true:warning                    # Предпочитать switch-выражение вместо оператора switch, если это уместно.
csharp_style_prefer_pattern_matching = true:warning                     # Предпочитать сопоставление с образцом вместо альтернативных проверок типов и значений.
csharp_style_prefer_not_pattern = true:warning                          # Предпочитать шаблон отрицания `not` вместо логического отрицания вокруг другого шаблона.

# --- СТИЛЬ C#: ОБЪЯВЛЕНИЯ И ВЫРАЖЕНИЯ ---
csharp_style_inlined_variable_declaration = true:warning                    # Предпочитать объявление переменной непосредственно в вызове out.
csharp_prefer_simple_default_expression = true:warning                      # Предпочитать краткую запись default вместо default(T), когда тип можно вывести.
csharp_style_pattern_local_over_anonymous_function = true:warning           # Предпочитать локальную функцию вместо анонимной функции в соответствующих случаях.
csharp_style_deconstructed_variable_declaration = true:warning              # Предпочитать деконструкцию при объявлении нескольких переменных из кортежа или другого деконструируемого значения.
csharp_style_prefer_index_operator = true:warning                           # Предпочитать оператор индекса от конца `^` вместо вычисления индекса вручную.
csharp_style_prefer_range_operator = true:warning                           # Предпочитать оператор диапазона `..` для получения диапазона элементов.
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning  # Предпочитать неявное создание объекта `new()` при очевидном типе из контекста.

# --- СТИЛЬ C#: ПРОВЕРКИ НА NULL ---
csharp_style_throw_expression = true:warning            # Предпочитать выражение throw внутри условных и других выражений, когда это упрощает код.
csharp_style_conditional_delegate_call = true:warning   # Предпочитать условный вызов делегата `?.Invoke(...)`, чтобы не проверять его на null вручную.

# --- СТИЛЬ C#: БЛОКИ КОДА И USING ---
csharp_prefer_braces = true:warning                             # Требовать фигурные скобки для управляющих конструкций, даже если их тело состоит из одной инструкции.
csharp_prefer_simple_using_statement = true:warning             # Предпочитать краткую форму using без блока, когда ресурс используется в пределах одной инструкции.
dotnet_diagnostic.IDE0063.severity = warning                    # Задаёт строгость диагностики IDE0063: упрощение конструкции using.
csharp_using_directive_placement = outside_namespace:warning    # Размещать директивы using вне пространства имён.
csharp_prefer_static_local_function = true:warning              # Предпочитать static для локальных функций, которые не захватывают переменные внешней области.

# --- ПРАВИЛА ДЛЯ НЕИСПОЛЬЗУЕМОГО И ИЗБЫТОЧНОГО КОДА ---
[*.cs]
dotnet_code_quality_unused_parameters = all:warning  # Проверять неиспользуемые параметры во всех методах, а не только в публичном API.
dotnet_remove_unnecessary_suppression_exclusions = warning  # Значение warning включает проверку IDE0079 для всех диагностик: исключения не задаются.
dotnet_diagnostic.IDE0079.severity = warning  # Включить диагностику IDE0079 на уровне предупреждения.
[*.cs]
csharp_style_unused_value_expression_statement_preference = discard_variable  # Для неиспользуемого результата выражения предпочитать отбрасывание значения.
dotnet_diagnostic.IDE0058.severity = error  # Строгость IDE0058: результат выражения вычислен, но не используется.
csharp_style_unused_value_assignment_preference = discard_variable:warning  # Для неиспользуемого присваивания предпочитать отбрасывание значения.
dotnet_diagnostic.IDE0059.severity = warning  # Строгость IDE0059: присвоенное значение нигде не используется.

# --- ФОРМАТИРОВАНИЕ: ОБЩИЕ ПАРАМЕТРЫ .NET ---
[*.cs]
dotnet_sort_system_directives_first = true  # Сортировать директивы System.* раньше остальных директив using.
dotnet_separate_import_directive_groups = false  # Не разделять группы директив using пустыми строками.
dotnet_style_namespace_match_folder = true:warning  # Предпочитать пространство имён, соответствующее структуре папок проекта.

# --- ФОРМАТИРОВАНИЕ C#: ПЕРЕНОСЫ СТРОК ---
[*.cs]
csharp_new_line_before_open_brace = all  # Переносить открывающую фигурную скобку на новую строку для всех поддерживаемых конструкций.
csharp_new_line_before_else = true  # Начинать else с новой строки.
csharp_new_line_before_catch = true  # Начинать catch с новой строки.
csharp_new_line_before_finally = true  # Начинать finally с новой строки.
csharp_new_line_before_members_in_object_initializers = true  # Размещать каждый элемент инициализатора объекта с новой строки.
csharp_new_line_before_members_in_anonymous_types = true  # Размещать каждый элемент анонимного типа с новой строки.
csharp_new_line_between_query_expression_clauses = true  # Разделять части LINQ-выражения переносами строк.

# --- ФОРМАТИРОВАНИЕ C#: ОТСТУПЫ ---
csharp_indent_case_contents = true  # Делать отступ для содержимого секций case.
csharp_indent_switch_labels = true  # Настраивать отступы для меток case и default.
csharp_indent_labels = no_change  # Не изменять существующий отступ меток.
csharp_indent_block_contents = true  # Делать отступ для содержимого блоков кода.
csharp_indent_braces = false  # Не добавлять дополнительный отступ для самих фигурных скобок.
csharp_indent_case_contents_when_block = false  # Не добавлять дополнительный отступ для содержимого case, если оно заключено в отдельный блок.

# --- ФОРМАТИРОВАНИЕ C#: ПРОБЕЛЫ ---
csharp_space_after_cast = false  # Не ставить пробел после оператора приведения типа.
csharp_space_after_keywords_in_control_flow_statements = true  # Ставить пробел после ключевых слов управляющих конструкций (if, for, while и т. п.).
csharp_space_between_parentheses = false  # Не ставить пробелы непосредственно внутри круглых скобок.
csharp_space_before_colon_in_inheritance_clause = true  # Ставить пробел перед двоеточием в объявлении наследования.
csharp_space_after_colon_in_inheritance_clause = true  # Ставить пробел после двоеточия в объявлении наследования.
csharp_space_around_binary_operators = before_and_after  # Ставить пробелы до и после бинарных операторов.
csharp_space_between_method_declaration_parameter_list_parentheses = false  # Не ставить пробел после открывающей скобки в объявлении метода.
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false  # Не ставить пробелы внутри пустого списка параметров объявления метода.
csharp_space_between_method_declaration_name_and_open_parenthesis = false  # Не ставить пробел между именем метода и открывающей скобкой.
csharp_space_between_method_call_parameter_list_parentheses = false  # Не ставить пробел после открывающей скобки при вызове метода.
csharp_space_between_method_call_empty_parameter_list_parentheses = false  # Не ставить пробелы внутри пустого списка аргументов вызова метода.
csharp_space_between_method_call_name_and_opening_parenthesis = false  # Не ставить пробел между именем вызываемого метода и открывающей скобкой.
csharp_space_after_comma = true  # Ставить пробел после запятой.
csharp_space_before_comma = false  # Не ставить пробел перед запятой.
csharp_space_after_dot = false  # Не ставить пробел после точки при обращении к члену.
csharp_space_before_dot = false  # Не ставить пробел перед точкой при обращении к члену.
csharp_space_after_semicolon_in_for_statement = true  # Ставить пробел после точек с запятой в заголовке цикла for.
csharp_space_before_semicolon_in_for_statement = false  # Не ставить пробел перед точками с запятой в заголовке цикла for.
csharp_space_around_declaration_statements = false  # Не добавлять пробелы вокруг частей объявлений сверх заданных правил.
csharp_space_before_open_square_brackets = false  # Не ставить пробел перед открывающей квадратной скобкой.
csharp_space_between_empty_square_brackets = false  # Не ставить пробелы внутри пустых квадратных скобок.
csharp_space_between_square_brackets = false  # Не ставить пробелы внутри квадратных скобок.

# --- ФОРМАТИРОВАНИЕ C#: СОХРАНЕНИЕ ОДНОСТРОЧНЫХ КОНСТРУКЦИЙ ---
csharp_preserve_single_line_statements = false  # Не сохранять несколько инструкций на одной строке: форматтер может переносить их.
csharp_preserve_single_line_blocks = true  # Сохранять блоки кода на одной строке, если это допускается форматтером.

# --- ФОРМАТИРОВАНИЕ C#: ПРОСТРАНСТВА ИМЁН ---
[*.cs]
tab_width = 4  # Ширина символа табуляции — 4 позиции.
end_of_line = crlf  # Использовать окончания строк CRLF.
dotnet_style_allow_multiple_blank_lines_experimental = false:warning  # Запретить несколько пустых строк подряд. Экспериментальная настройка.
dotnet_style_allow_statement_immediately_after_block_experimental = true:warning  # Разрешать размещать инструкцию сразу после закрывающей скобки блока. Экспериментальная настройка.
dotnet_style_prefer_rules_on_unreferenced_code = true  # Применять правила стиля также к коду, на который нет ссылок.

# --- СОГЛАШЕНИЯ ОБ ИМЕНОВАНИИ ---
[*.cs]
# Каждое правило связывает группу символов с требуемым стилем и уровнем строгости.
dotnet_naming_rule.interface_should_be_begins_with_i.severity = error   # Интерфейсы: имя должно начинаться с заглавной I.
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i
dotnet_naming_rule.types_should_be_pascalcase.severity = warning    # Типы (классы, структуры, интерфейсы и перечисления): PascalCase.
dotnet_naming_rule.types_should_be_pascalcase.symbols = types
dotnet_naming_rule.types_should_be_pascalcase.style = pascalcase
dotnet_naming_rule.non_field_members_should_be_pascalcase.severity = warning    # Свойства, события и методы: PascalCase.
dotnet_naming_rule.non_field_members_should_be_pascalcase.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascalcase.style = pascalcase
dotnet_naming_rule.enum_should_be_begins_with_e.severity = error    # Перечисления: имя должно начинаться с заглавной E.
dotnet_naming_rule.enum_should_be_begins_with_e.symbols = enum
dotnet_naming_rule.enum_should_be_begins_with_e.style = begins_with_e
dotnet_naming_rule.public_or_protected_field_should_be_camelcase.severity = warning     # Открытые и защищённые поля: camelCase.
dotnet_naming_rule.public_or_protected_field_should_be_camelcase.symbols = public_or_protected_field
dotnet_naming_rule.public_or_protected_field_should_be_camelcase.style = camelcase
dotnet_naming_rule.private_or_internal_field_should_be_camelcasewith_.severity = warning    # Приватные и internal-поля: camelCase с начальным символом подчёркивания.
dotnet_naming_rule.private_or_internal_field_should_be_camelcasewith_.symbols = private_or_internal_field
dotnet_naming_rule.private_or_internal_field_should_be_camelcasewith_.style = camelcasewith_
dotnet_naming_rule.property_should_be_pascalcase.severity = warning     # Свойства: PascalCase.
dotnet_naming_rule.property_should_be_pascalcase.symbols = property
dotnet_naming_rule.property_should_be_pascalcase.style = pascalcase
dotnet_naming_rule.method_should_be_pascalcase.severity = error     # Публичные методы: PascalCase.
dotnet_naming_rule.method_should_be_pascalcase.symbols = method
dotnet_naming_rule.method_should_be_pascalcase.style = pascalcase
dotnet_naming_rule.private_method_should_be_pascalcase.severity = error     # Приватные методы: PascalCase.
dotnet_naming_rule.private_method_should_be_pascalcase.symbols = private_method
dotnet_naming_rule.private_method_should_be_pascalcase.style = pascalcase
dotnet_naming_rule.abstract_method_should_be_pascalcase.severity = error    # Абстрактные методы: PascalCase.
dotnet_naming_rule.abstract_method_should_be_pascalcase.symbols = abstract_method
dotnet_naming_rule.abstract_method_should_be_pascalcase.style = pascalcase
dotnet_naming_rule.static_method_should_be_pascalcase.severity = error      # Статические методы: PascalCase.
dotnet_naming_rule.static_method_should_be_pascalcase.symbols = static_method
dotnet_naming_rule.static_method_should_be_pascalcase.style = pascalcase
dotnet_naming_rule.class_should_be_pascalcase.severity = error      # Классы: PascalCase.
dotnet_naming_rule.class_should_be_pascalcase.symbols = class
dotnet_naming_rule.class_should_be_pascalcase.style = pascalcase
dotnet_naming_rule.delegate_should_be_pascalcase.severity = warning # Делегаты: PascalCase.
dotnet_naming_rule.delegate_should_be_pascalcase.symbols = delegate
dotnet_naming_rule.delegate_should_be_pascalcase.style = pascalcase
dotnet_naming_rule.event_should_be_camelcase.severity = warning     # События: camelCase.
dotnet_naming_rule.event_should_be_camelcase.symbols = event
dotnet_naming_rule.event_should_be_camelcase.style = camelcase
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i
dotnet_naming_rule.public_protected_static_readonly_fields_must_be_pascal_case_rule.severity = warning      # Публичные и защищённые static readonly-поля: PascalCase.
dotnet_naming_rule.public_protected_static_readonly_fields_must_be_pascal_case_rule.symbols = public_protected_static_readonly_fields_group
dotnet_naming_rule.public_protected_static_readonly_fields_must_be_pascal_case_rule.style = pascalcase
dotnet_naming_rule.parameters_rule.symbols = parameters_group
dotnet_naming_rule.parameters_rule.style = camelcase
dotnet_naming_rule.parameters_rule.severity = warning               # Параметры методов: camelCase.
dotnet_naming_rule.type_parameter_rule.symbols = type_parameter_group
dotnet_naming_rule.type_parameter_rule.style = prefix_type_parameters_with_t_style
dotnet_naming_rule.type_parameter_rule.severity = warning           # Параметры типов: PascalCase с префиксом T.

# --- НАСТРОЙКИ СТАТИЧЕСКИХ АНАЛИЗАТОРОВ ---
[*.cs]
dotnet_code_quality.copy_analysis = true      # Включает анализ копирования значений и ссылок для тех диагностик .NET, которые его поддерживают.
# --- АНАЛИЗАТОРЫ ROSLYN: СТИЛЬ И УПРОЩЕНИЕ КОДА ---
dotnet_diagnostic.IDE0001.severity = warning  # Упрощение имени: удаление лишней квалификации.
dotnet_diagnostic.IDE0002.severity = warning  # Упрощение обращения к члену типа.
dotnet_diagnostic.IDE0004.severity = warning  # Удаление ненужного приведения типа.
dotnet_diagnostic.IDE0005.severity = error    # Удаление ненужной директивы using или импорта.
# dotnet_diagnostic.IDE0007.severity = error  # Предпочтение явного типа вместо var.
# dotnet_diagnostic.IDE0008.severity = error  # Предпочтение var вместо явного типа.
dotnet_diagnostic.IDE0011.severity = warning  # Добавление фигурных скобок к управляющим конструкциям.
dotnet_diagnostic.IDE0035.severity = warning  # Удаление недостижимого кода.
dotnet_diagnostic.IDE0045.severity = warning  # Использование условного выражения вместо if с присваиванием.
dotnet_diagnostic.IDE0046.severity = warning  # Использование условного выражения вместо if с возвратом значения.
dotnet_diagnostic.IDE0051.severity = error    # Удаление неиспользуемого закрытого члена типа.
dotnet_diagnostic.IDE0052.severity = error    # Удаление закрытого члена типа, значение которого нигде не читается.
dotnet_diagnostic.IDE0055.severity = error
dotnet_diagnostic.IDE0059.severity = warning  # Удаление присваивания неиспользуемого значения.
dotnet_diagnostic.IDE0161.severity = error    # Преобразование блочного объявления пространства имён в файловое.

# --- АНАЛИЗАТОРЫ .NET: ПРОЕКТИРОВАНИЕ API И ОБЪЕКТНАЯ МОДЕЛЬ ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
dotnet_diagnostic.CA1000.severity = warning  # Не объявлять статические члены в обобщённых типах.
dotnet_diagnostic.CA1001.severity = warning  # Тип, владеющий полями с IDisposable, должен сам реализовывать IDisposable.
dotnet_diagnostic.CA1018.severity = warning  # Помечать пользовательские атрибуты атрибутом AttributeUsage.
dotnet_diagnostic.CA1019.severity = warning  # Предоставлять свойства для чтения аргументов атрибута.
dotnet_diagnostic.CA1036.severity = warning  # Переопределять Equals и операторы сравнения для типов, реализующих IComparable.
dotnet_diagnostic.CA1067.severity = warning  # Переопределять Equals, если тип реализует IEquatable<T>.
dotnet_diagnostic.CA1068.severity = warning  # Размещать параметр CancellationToken последним в списке параметров.

# --- АНАЛИЗАТОРЫ .NET: ГЛОБАЛИЗАЦИЯ, СТРОКИ И СРАВНЕНИЯ ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
dotnet_diagnostic.CA1303.severity = warning  # Не передавать строковые литералы вместо локализуемых строк в публичные методы.
dotnet_diagnostic.CA1304.severity = warning  # Явно указывать CultureInfo при вызове методов, поддерживающих такой параметр.
dotnet_diagnostic.CA1305.severity = warning  # Явно указывать IFormatProvider при форматировании и преобразовании значений.
dotnet_diagnostic.CA1307.severity = warning  # Явно указывать StringComparison при сравнении строк.
dotnet_diagnostic.CA1308.severity = warning  # Нормализовать строки в верхний регистр, а не в нижний.
dotnet_diagnostic.CA1309.severity = warning  # Использовать порядковое сравнение строк (Ordinal или OrdinalIgnoreCase), когда сравнение не зависит от языка.
dotnet_diagnostic.CA1310.severity = warning  # Явно задавать StringComparison, чтобы избежать непреднамеренного сравнения с учётом текущей культуры.

# --- АНАЛИЗАТОРЫ .NET: ВЗАИМОДЕЙСТВИЕ С ПЛАТФОРМОЙ И НЕУПРАВЛЯЕМЫМ КОДОМ ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
dotnet_diagnostic.CA1401.severity = warning  # Не делать методы P/Invoke общедоступными или защищёнными.
dotnet_diagnostic.CA1416.severity = warning  # Проверять совместимость платформы перед использованием платформозависимых API.
dotnet_diagnostic.CA1417.severity = warning  # Не применять OutAttribute к строковым параметрам P/Invoke, передаваемым по значению.
dotnet_diagnostic.CA2101.severity = warning  # Явно задавать способ маршалинга строковых аргументов P/Invoke.

# --- АНАЛИЗАТОРЫ .NET: ИМЕНОВАНИЕ И СОГЛАСОВАННОСТЬ API ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
dotnet_diagnostic.CA1708.severity = warning  # Идентификаторы не должны различаться только регистром символов.
dotnet_diagnostic.CA1710.severity = warning  # Использовать суффиксы типов, соответствующие базовому типу или реализуемому интерфейсу.
dotnet_diagnostic.CA1711.severity = warning  # Не использовать зарезервированные суффиксы типов там, где они не соответствуют назначению типа.
dotnet_diagnostic.CA1724.severity = warning  # Не давать типам имена, совпадающие с именами пространств имён .NET.

# --- АНАЛИЗАТОРЫ .NET: НАДЁЖНОСТЬ, ПОТОКИ И АСИНХРОННЫЙ КОД ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
dotnet_diagnostic.CA1508.severity = warning  # Удалять условные ветви, условие которых всегда истинно или ложно.
dotnet_diagnostic.CA2002.severity = warning  # Не блокировать потоки через объекты со слабой идентичностью.
dotnet_diagnostic.CA2009.severity = warning  # Не вызывать ToImmutable() для коллекции, которая уже является неизменяемой.
dotnet_diagnostic.CA2012.severity = warning  # Правильно использовать ValueTask: не потреблять один экземпляр несколько раз и не игнорировать его результат.
dotnet_diagnostic.CA2013.severity = warning  # Не использовать ReferenceEquals для сравнения значимых типов.
dotnet_diagnostic.CA2014.severity = warning  # Не использовать stackalloc внутри циклов: выделенная область стека освобождается только при выходе из метода.
dotnet_diagnostic.CA2015.severity = warning  # Не объявлять финализаторы для типов, производных от MemoryManager<T>.
dotnet_diagnostic.CA2016.severity = warning  # Передавать полученный CancellationToken во вложенные методы, которые его поддерживают.
dotnet_diagnostic.CA2119.severity = warning  # Запечатывать методы, реализующие закрытые интерфейсы, чтобы их нельзя было переопределить за пределами сборки.

# --- АНАЛИЗАТОРЫ .NET: ИСКЛЮЧЕНИЯ, КОНТРАКТЫ И КОРРЕКТНОСТЬ API ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
dotnet_diagnostic.CA2200.severity = warning  # Повторно выбрасывать исключение через throw без указания переменной, чтобы сохранить исходную трассировку стека.
dotnet_diagnostic.CA2201.severity = warning  # Не выбрасывать типы исключений, зарезервированные для среды выполнения.
dotnet_diagnostic.CA2208.severity = warning  # Правильно создавать ArgumentException и производные исключения, передавая корректное имя параметра.
dotnet_diagnostic.CA2215.severity = warning  # Вызывать Dispose базового класса из реализации Dispose производного класса.
dotnet_diagnostic.CA2219.severity = warning  # Не выбрасывать исключения из блоков finally, fault и фильтров исключений.
dotnet_diagnostic.CA2226.severity = warning  # При перегрузке оператора равенства или неравенства реализовывать симметричную парную перегрузку.
dotnet_diagnostic.CA2242.severity = warning  # Проверять NaN с помощью Single.IsNaN() или Double.IsNaN(), а не сравнением с NaN.
dotnet_diagnostic.CA2243.severity = warning  # Передавать в строковые аргументы атрибутов корректные URL, GUID и версии.
dotnet_diagnostic.CA2244.severity = warning  # Не повторять инициализацию одного и того же индексированного элемента в инициализаторе объекта.
dotnet_diagnostic.CA2245.severity = warning  # Не присваивать свойству его собственное значение.
dotnet_diagnostic.CA2246.severity = warning  # Не присваивать переменной и её полю или свойству значения в одной инструкции.
dotnet_diagnostic.CA2247.severity = warning  # Передавать в конструктор TaskCompletionSource значение TaskCreationOptions, а не TaskContinuationOptions.
dotnet_diagnostic.CA2248.severity = warning  # Передавать в Enum.HasFlag значение того же типа перечисления, что и проверяемое значение.
dotnet_diagnostic.CA2249.severity = warning  # Использовать String.Contains() вместо String.IndexOf(), если требуется только проверить наличие подстроки.
