# --- НАСТРОЙКИ СТАТИЧЕСКИХ АНАЛИЗАТОРОВ ---

[Assets/Game/**/*.{cs,csx,cake,vb,vbx}]
# Включает анализ копирования значений и ссылок для тех диагностик .NET, которые его поддерживают.
dotnet_code_quality.copy_analysis = true

# --- АНАЛИЗАТОРЫ ROSLYN: СТИЛЬ И УПРОЩЕНИЕ КОДА ---
# Упрощение имени: удаление лишней квалификации.
dotnet_diagnostic.IDE0001.severity = suggestion
# Упрощение обращения к члену типа.
dotnet_diagnostic.IDE0002.severity = suggestion
# Удаление ненужного приведения типа.
dotnet_diagnostic.IDE0004.severity = suggestion
# Удаление ненужной директивы using или импорта.
dotnet_diagnostic.IDE0005.severity = error
# Предпочтение явного типа вместо var.
dotnet_diagnostic.IDE0007.severity = error
# Предпочтение var вместо явного типа.
dotnet_diagnostic.IDE0008.severity = error
# Добавление фигурных скобок к управляющим конструкциям.
dotnet_diagnostic.IDE0011.severity = warning
# Удаление недостижимого кода.
dotnet_diagnostic.IDE0035.severity = warning
# Использование условного выражения вместо if с присваиванием.
dotnet_diagnostic.IDE0045.severity = suggestion
# Использование условного выражения вместо if с возвратом значения.
dotnet_diagnostic.IDE0046.severity = suggestion
# Удаление неиспользуемого закрытого члена типа.
dotnet_diagnostic.IDE0051.severity = error
# Удаление закрытого члена типа, значение которого нигде не читается.
dotnet_diagnostic.IDE0052.severity = error
# Удаление присваивания неиспользуемого значения.
dotnet_diagnostic.IDE0059.severity = warning
# Преобразование блочного объявления пространства имён в файловое.
dotnet_diagnostic.IDE0161.severity = error
# Нарушение соглашений об именовании.
dotnet_diagnostic.IDE1006.severity = warning

# --- АНАЛИЗАТОРЫ .NET: ПРОЕКТИРОВАНИЕ API И ОБЪЕКТНАЯ МОДЕЛЬ ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
# Не объявлять статические члены в обобщённых типах.
dotnet_diagnostic.CA1000.severity = warning
# Тип, владеющий полями с IDisposable, должен сам реализовывать IDisposable.
dotnet_diagnostic.CA1001.severity = warning
# Помечать пользовательские атрибуты атрибутом AttributeUsage.
dotnet_diagnostic.CA1018.severity = warning
# Предоставлять свойства для чтения аргументов атрибута.
dotnet_diagnostic.CA1019.severity = warning
# Переопределять Equals и операторы сравнения для типов, реализующих IComparable.
dotnet_diagnostic.CA1036.severity = warning
# Переопределять Equals, если тип реализует IEquatable<T>.
dotnet_diagnostic.CA1067.severity = warning
# Размещать параметр CancellationToken последним в списке параметров.
dotnet_diagnostic.CA1068.severity = warning

# --- АНАЛИЗАТОРЫ .NET: ГЛОБАЛИЗАЦИЯ, СТРОКИ И СРАВНЕНИЯ ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
# Не передавать строковые литералы вместо локализуемых строк в публичные методы.
dotnet_diagnostic.CA1303.severity = none
# Явно указывать CultureInfo при вызове методов, поддерживающих такой параметр.
dotnet_diagnostic.CA1304.severity = warning
# Явно указывать IFormatProvider при форматировании и преобразовании значений.
dotnet_diagnostic.CA1305.severity = warning
# Явно указывать StringComparison при сравнении строк.
dotnet_diagnostic.CA1307.severity = warning
# Нормализовать строки в верхний регистр, а не в нижний.
dotnet_diagnostic.CA1308.severity = warning
# Использовать порядковое сравнение строк (Ordinal или OrdinalIgnoreCase), когда сравнение не зависит от языка.
dotnet_diagnostic.CA1309.severity = warning
# Явно задавать StringComparison, чтобы избежать непреднамеренного сравнения с учётом текущей культуры.
dotnet_diagnostic.CA1310.severity = warning

# --- АНАЛИЗАТОРЫ .NET: ВЗАИМОДЕЙСТВИЕ С ПЛАТФОРМОЙ И НЕУПРАВЛЯЕМЫМ КОДОМ ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
# Не делать методы P/Invoke общедоступными или защищёнными.
dotnet_diagnostic.CA1401.severity = warning
# Проверять совместимость платформы перед использованием платформозависимых API.
dotnet_diagnostic.CA1416.severity = warning
# Не применять OutAttribute к строковым параметрам P/Invoke, передаваемым по значению.
dotnet_diagnostic.CA1417.severity = warning
# Явно задавать способ маршалинга строковых аргументов P/Invoke.
dotnet_diagnostic.CA2101.severity = warning

# --- АНАЛИЗАТОРЫ .NET: ИМЕНОВАНИЕ И СОГЛАСОВАННОСТЬ API ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
# Идентификаторы не должны различаться только регистром символов.
dotnet_diagnostic.CA1708.severity = warning
# Использовать суффиксы типов, соответствующие базовому типу или реализуемому интерфейсу.
dotnet_diagnostic.CA1710.severity = none
# Не использовать зарезервированные суффиксы типов там, где они не соответствуют назначению типа.
dotnet_diagnostic.CA1711.severity = none
# Не давать типам имена, совпадающие с именами пространств имён .NET.
dotnet_diagnostic.CA1724.severity = warning

# --- АНАЛИЗАТОРЫ .NET: ПРОИЗВОДИТЕЛЬНОСТЬ ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
# Не инициализировать поля и переменные явно значениями по умолчанию без необходимости.
dotnet_diagnostic.CA1805.severity = warning
# Не игнорировать возвращаемые значения методов и результаты создания объектов.
dotnet_diagnostic.CA1806.severity = warning
# Объявлять пользовательские атрибуты sealed, если от них не предполагается наследование.
dotnet_diagnostic.CA1813.severity = warning
# Удалять пустые финализаторы.
dotnet_diagnostic.CA1821.severity = warning
# Использовать Array.Empty<T>() вместо создания массивов нулевой длины.
dotnet_diagnostic.CA1825.severity = warning
# Использовать более эффективное свойство вместо эквивалентного метода LINQ, если оно доступно.
dotnet_diagnostic.CA1826.severity = warning
# Использовать Any() вместо Count() или LongCount(), когда нужно только проверить наличие элементов.
dotnet_diagnostic.CA1827.severity = warning
# Использовать AnyAsync() вместо CountAsync() или LongCountAsync(), когда нужно только проверить наличие элементов.
dotnet_diagnostic.CA1828.severity = warning
# Использовать свойство Length или Count вместо Enumerable.Count(), если оно доступно.
dotnet_diagnostic.CA1829.severity = warning
# Использовать типизированные перегрузки Append и Insert у StringBuilder вместо преобразования аргументов в строки.
dotnet_diagnostic.CA1830.severity = warning
# Использовать AsSpan() вместо индексатора диапазона для строки, если результатом должен быть ReadOnlySpan<char>.
dotnet_diagnostic.CA1831.severity = warning
# Использовать AsSpan() или AsMemory() вместо индексатора диапазона для получения ReadOnlySpan или ReadOnlyMemory массива.
dotnet_diagnostic.CA1832.severity = warning
# Использовать AsSpan() или AsMemory() вместо индексатора диапазона для получения Span или Memory массива.
dotnet_diagnostic.CA1833.severity = warning
# Использовать StringBuilder.Append(char) для добавления одного символа.
dotnet_diagnostic.CA1834.severity = warning
# Предпочитать перегрузки ReadAsync и WriteAsync, принимающие Memory или ReadOnlyMemory.
dotnet_diagnostic.CA1835.severity = warning
# Использовать IsEmpty вместо Count или Length, если такое свойство доступно.
dotnet_diagnostic.CA1836.severity = warning
# Использовать Environment.ProcessId вместо Process.GetCurrentProcess().Id.
dotnet_diagnostic.CA1837.severity = warning
# Не использовать StringBuilder в строковых параметрах P/Invoke: маршалинг создаёт дополнительные копии и выделения памяти.
dotnet_diagnostic.CA1838.severity = warning

# --- АНАЛИЗАТОРЫ .NET: НАДЁЖНОСТЬ, ПОТОКИ И АСИНХРОННЫЙ КОД ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
# Удалять условные ветви, условие которых всегда истинно или ложно.
dotnet_diagnostic.CA1508.severity = none
# Не блокировать потоки через объекты со слабой идентичностью.
dotnet_diagnostic.CA2002.severity = warning
# Не вызывать ToImmutable() для коллекции, которая уже является неизменяемой.
dotnet_diagnostic.CA2009.severity = warning
# Правильно использовать ValueTask: не потреблять один экземпляр несколько раз и не игнорировать его результат.
dotnet_diagnostic.CA2012.severity = warning
# Не использовать ReferenceEquals для сравнения значимых типов.
dotnet_diagnostic.CA2013.severity = warning
# Не использовать stackalloc внутри циклов: выделенная область стека освобождается только при выходе из метода.
dotnet_diagnostic.CA2014.severity = warning
# Не объявлять финализаторы для типов, производных от MemoryManager<T>.
dotnet_diagnostic.CA2015.severity = warning
# Передавать полученный CancellationToken во вложенные методы, которые его поддерживают.
dotnet_diagnostic.CA2016.severity = warning
# Запечатывать методы, реализующие закрытые интерфейсы, чтобы их нельзя было переопределить за пределами сборки.
dotnet_diagnostic.CA2119.severity = warning

# --- АНАЛИЗАТОРЫ .NET: ИСКЛЮЧЕНИЯ, КОНТРАКТЫ И КОРРЕКТНОСТЬ API ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
# Повторно выбрасывать исключение через throw без указания переменной, чтобы сохранить исходную трассировку стека.
dotnet_diagnostic.CA2200.severity = warning
# Не выбрасывать типы исключений, зарезервированные для среды выполнения.
dotnet_diagnostic.CA2201.severity = warning
# Правильно создавать ArgumentException и производные исключения, передавая корректное имя параметра.
dotnet_diagnostic.CA2208.severity = warning
# Вызывать Dispose базового класса из реализации Dispose производного класса.
dotnet_diagnostic.CA2215.severity = warning
# Не выбрасывать исключения из блоков finally, fault и фильтров исключений.
dotnet_diagnostic.CA2219.severity = warning
# При перегрузке оператора равенства или неравенства реализовывать симметричную парную перегрузку.
dotnet_diagnostic.CA2226.severity = warning
# Проверять NaN с помощью Single.IsNaN() или Double.IsNaN(), а не сравнением с NaN.
dotnet_diagnostic.CA2242.severity = warning
# Передавать в строковые аргументы атрибутов корректные URL, GUID и версии.
dotnet_diagnostic.CA2243.severity = warning
# Не повторять инициализацию одного и того же индексированного элемента в инициализаторе объекта.
dotnet_diagnostic.CA2244.severity = warning
# Не присваивать свойству его собственное значение.
dotnet_diagnostic.CA2245.severity = warning
# Не присваивать переменной и её полю или свойству значения в одной инструкции.
dotnet_diagnostic.CA2246.severity = warning
# Передавать в конструктор TaskCompletionSource значение TaskCreationOptions, а не TaskContinuationOptions.
dotnet_diagnostic.CA2247.severity = warning
# Передавать в Enum.HasFlag значение того же типа перечисления, что и проверяемое значение.
dotnet_diagnostic.CA2248.severity = warning
# Использовать String.Contains() вместо String.IndexOf(), если требуется только проверить наличие подстроки.
dotnet_diagnostic.CA2249.severity = warning

# --- АНАЛИЗАТОРЫ .NET: БЕЗОПАСНОСТЬ ДЕСЕРИАЛИЗАЦИИ ---
# Назначение каждой диагностики указано в комментарии перед её настройкой.
# Не использовать небезопасный десериализатор BinaryFormatter.
dotnet_diagnostic.CA2300.severity = warning
# Задавать Binder для BinaryFormatter до вызова Deserialize().
dotnet_diagnostic.CA2301.severity = warning
# Гарантировать, что Binder задан до вызова BinaryFormatter.Deserialize().
dotnet_diagnostic.CA2302.severity = warning
# Не использовать небезопасный десериализатор LosFormatter.
dotnet_diagnostic.CA2305.severity = warning
# Не использовать небезопасный десериализатор NetDataContractSerializer.
dotnet_diagnostic.CA2310.severity = warning
