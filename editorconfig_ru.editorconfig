











# --- СТИЛЬ .NET: ИНИЦИАЛИЗАЦИЯ И ВЫРАЖЕНИЯ ---
# Предпочитать инициализаторы объектов вместо последовательного присваивания свойств после создания объекта.
dotnet_style_object_initializer = true:warning
# Предпочитать инициализаторы коллекций.
dotnet_style_collection_initializer = true:warning
# Задавать явные имена элементам кортежей, если это повышает понятность кода.
dotnet_style_explicit_tuple_names = true:warning
# Предпочитать вывод имён элементов кортежа из имён выражений.
dotnet_style_prefer_inferred_tuple_names = true:warning
# Предпочитать вывод имён свойств анонимного типа из имён выражений.
dotnet_style_prefer_inferred_anonymous_type_member_names = true:warning
# Предпочитать автоматически реализуемые свойства, если дополнительная логика доступа не нужна.
dotnet_style_prefer_auto_properties = true:warning
# Не заменять присваивание условным выражением только ради сокращения записи.
dotnet_style_prefer_conditional_expression_over_assignment = false:suggestion
# Не заменять конструкцию return условным выражением только ради сокращения записи.
dotnet_style_prefer_conditional_expression_over_return = false:suggestion
# Предпочитать составные операторы присваивания, например += вместо x = x + ... .
dotnet_style_prefer_compound_assignment = true:warning
# Предпочитать упрощённую интерполяцию строк, если она эквивалентна исходной записи.
dotnet_style_prefer_simplified_interpolation = true:warning
# Предпочитать упрощённые логические выражения без лишних сравнений с true или false.
dotnet_style_prefer_simplified_boolean_expressions = true:warning

# --- СТИЛЬ .NET: ПРОВЕРКА НА NULL ---
# Предпочитать оператор объединения с NULL (??), когда он заменяет явную проверку на null.
dotnet_style_coalesce_expression = true:warning
# Предпочитать условный доступ к члену (?.), когда он заменяет проверку на null.
dotnet_style_null_propagation = true:warning
# Предпочитать проверку `is null` вместо вызова ReferenceEquals для проверки на null.
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning

# --- СТИЛЬ .NET: ДОПОЛНИТЕЛЬНЫЕ ПРАВИЛА ---
# При переносе выражения на новую строку размещать оператор в начале строки.
dotnet_style_operator_placement_when_wrapping = beginning_of_line
# Предпочитать проверку на null вместо проверки типа, если проверка типа используется только для выявления null.
csharp_style_prefer_null_check_over_type_check = true:warning
# Предпочитать передачу группы методов вместо избыточного лямбда-выражения.
csharp_style_prefer_method_group_conversion = true:silent
# Предпочитать инструкции верхнего уровня, когда структура программы это допускает.
csharp_style_prefer_top_level_statements = true:silent
# Предпочитать локальную функцию анонимной функции, если это делает код понятнее.
csharp_style_prefer_local_over_anonymous_function = true:suggestion
# Предпочитать обмен значениями кортежа вместо временной переменной.
csharp_style_prefer_tuple_swap = true:suggestion
# Предпочитать строковые литералы UTF-8, когда это подходит для работы с данными UTF-8.
csharp_style_prefer_utf8_string_literals = true:suggestion
# Разрешать размещать вложенную инструкцию на одной строке с управляющей конструкцией. Экспериментальная настройка.
csharp_style_allow_embedded_statements_on_same_line_experimental = true:silent
# Разрешать пустую строку после двоеточия в инициализаторе конструктора. Экспериментальная настройка.
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = true:silent
# Разрешать пустые строки между соседними закрывающими и открывающими фигурными скобками. Экспериментальная настройка.
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = true:silent
# Предпочитать расширенный шаблон свойств, когда он позволяет компактнее записать проверку вложенных свойств.
csharp_style_prefer_extended_property_pattern = true:suggestion

# --- СТИЛЬ C#: НЕЯВНО ТИПИЗИРОВАННЫЕ ПЕРЕМЕННЫЕ VAR ---

[Assets/Game/**/*.{cs,csx,cake}]
# Предпочитать var при объявлении переменных встроенных типов (int, string и т. п.).
csharp_style_var_for_built_in_types = true:warning
# Предпочитать var, когда тип очевиден из правой части выражения.
csharp_style_var_when_type_is_apparent = true:warning
# Предпочитать var и в остальных случаях.
csharp_style_var_elsewhere = true:warning

# --- СТИЛЬ C#: ВЫРАЖЕНИЯ С ТЕЛОМ-ВЫРАЖЕНИЕМ ---
# Предпочитать тело-выражение для методов, когда тело состоит из одного выражения.
csharp_style_expression_bodied_methods = true:warning
# Предпочитать тело-выражение для конструкторов, когда это возможно.
csharp_style_expression_bodied_constructors = true:warning
# Предпочитать тело-выражение для перегруженных операторов.
csharp_style_expression_bodied_operators = true:warning
# Предпочитать тело-выражение для свойств.
csharp_style_expression_bodied_properties = true:warning
# Предпочитать тело-выражение для индексаторов.
csharp_style_expression_bodied_indexers = true:warning
# Предпочитать тело-выражение для методов доступа свойств и индексаторов.
csharp_style_expression_bodied_accessors = true:warning
# Предпочитать тело-выражение для лямбда-выражений.
csharp_style_expression_bodied_lambdas = true:warning
# Предпочитать тело-выражение для локальных функций.
csharp_style_expression_bodied_local_functions = true:warning

# --- СТИЛЬ C#: СОПОСТАВЛЕНИЕ С ОБРАЗЦОМ (PATTERN MATCHING) ---
# Предпочитать сопоставление с образцом вместо проверки is с последующим приведением типа.
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
# Предпочитать сопоставление с образцом вместо as с последующей проверкой на null.
csharp_style_pattern_matching_over_as_with_null_check = true:warning
# Предпочитать switch-выражение вместо оператора switch, если это уместно.
csharp_style_prefer_switch_expression = true:warning
# Предпочитать сопоставление с образцом вместо альтернативных проверок типов и значений.
csharp_style_prefer_pattern_matching = true:warning
# Предпочитать шаблон отрицания `not` вместо логического отрицания вокруг другого шаблона.
csharp_style_prefer_not_pattern = true:warning

# --- СТИЛЬ C#: ОБЪЯВЛЕНИЯ И ВЫРАЖЕНИЯ ---
# Предпочитать объявление переменной непосредственно в вызове out.
csharp_style_inlined_variable_declaration = true:warning
# Предпочитать краткую запись default вместо default(T), когда тип можно вывести.
csharp_prefer_simple_default_expression = true:warning
# Предпочитать локальную функцию вместо анонимной функции в соответствующих случаях.
csharp_style_pattern_local_over_anonymous_function = true:warning
# Предпочитать деконструкцию при объявлении нескольких переменных из кортежа или другого деконструируемого значения.
csharp_style_deconstructed_variable_declaration = true:warning
# Предпочитать оператор индекса от конца `^` вместо вычисления индекса вручную.
csharp_style_prefer_index_operator = true:warning
# Предпочитать оператор диапазона `..` для получения диапазона элементов.
csharp_style_prefer_range_operator = true:warning
# Предпочитать неявное создание объекта `new()` при очевидном типе из контекста.
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning

# --- СТИЛЬ C#: ПРОВЕРКИ НА NULL ---
# Предпочитать выражение throw внутри условных и других выражений, когда это упрощает код.
csharp_style_throw_expression = true:warning
# Предпочитать условный вызов делегата `?.Invoke(...)`, чтобы не проверять его на null вручную.
csharp_style_conditional_delegate_call = true:warning

# --- СТИЛЬ C#: БЛОКИ КОДА И USING ---
# Требовать фигурные скобки для управляющих конструкций, даже если их тело состоит из одной инструкции.
csharp_prefer_braces = true:warning
# Предпочитать краткую форму using без блока, когда ресурс используется в пределах одной инструкции.
csharp_prefer_simple_using_statement = true:suggestion
# Задаёт строгость диагностики IDE0063: упрощение конструкции using.
dotnet_diagnostic.IDE0063.severity = suggestion
# Размещать директивы using вне пространства имён.
csharp_using_directive_placement = outside_namespace:warning
# Предпочитать static для локальных функций, которые не захватывают переменные внешней области.
csharp_prefer_static_local_function = true:warning

# --- ПРАВИЛА ДЛЯ НЕИСПОЛЬЗУЕМОГО И ИЗБЫТОЧНОГО КОДА ---

[Assets/Game/**/*.{cs,csx,cake,vb,vbx}]
# Проверять неиспользуемые параметры во всех методах, а не только в публичном API.
dotnet_code_quality_unused_parameters = all:warning
# Значение none включает проверку IDE0079 для всех диагностик: исключения не задаются.
dotnet_remove_unnecessary_suppression_exclusions = none
# Включить диагностику IDE0079 на уровне предупреждения.
dotnet_diagnostic.IDE0079.severity = warning

[Assets/Game/**/*.{cs,csx,cake}]
# Для неиспользуемого результата выражения предпочитать отбрасывание значения.
csharp_style_unused_value_expression_statement_preference = discard_variable
# Строгость IDE0058: результат выражения вычислен, но не используется.
dotnet_diagnostic.IDE0058.severity = error
# Для неиспользуемого присваивания предпочитать отбрасывание значения.
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
# Строгость IDE0059: присвоенное значение нигде не используется.
dotnet_diagnostic.IDE0059.severity = suggestion

# --- ФОРМАТИРОВАНИЕ: ОБЩИЕ ПАРАМЕТРЫ .NET ---

[Assets/Game/**/*.{cs,csx,cake,vb,vbx}]
# Сортировать директивы System.* раньше остальных директив using.
dotnet_sort_system_directives_first = true
# Не разделять группы директив using пустыми строками.
dotnet_separate_import_directive_groups = false
# Предпочитать пространство имён, соответствующее структуре папок проекта.
dotnet_style_namespace_match_folder = true:suggestion
# Строгость IDE0130: пространство имён не соответствует структуре папок или заданному соглашению.
dotnet_diagnostic.IDE0130.severity = suggestion

# --- ФОРМАТИРОВАНИЕ C#: ПЕРЕНОСЫ СТРОК ---

[Assets/Game/**/*.{cs,csx,cake}]
# Переносить открывающую фигурную скобку на новую строку для всех поддерживаемых конструкций.
csharp_new_line_before_open_brace = all
# Начинать else с новой строки.
csharp_new_line_before_else = true
# Начинать catch с новой строки.
csharp_new_line_before_catch = true
# Начинать finally с новой строки.
csharp_new_line_before_finally = true
# Размещать каждый элемент инициализатора объекта с новой строки.
csharp_new_line_before_members_in_object_initializers = true
# Размещать каждый элемент анонимного типа с новой строки.
csharp_new_line_before_members_in_anonymous_types = true
# Разделять части LINQ-выражения переносами строк.
csharp_new_line_between_query_expression_clauses = true

# --- ФОРМАТИРОВАНИЕ C#: ОТСТУПЫ ---
# Делать отступ для содержимого секций case.
csharp_indent_case_contents = true
# Настраивать отступы для меток case и default.
csharp_indent_switch_labels = true
# Не изменять существующий отступ меток.
csharp_indent_labels = no_change
# Делать отступ для содержимого блоков кода.
csharp_indent_block_contents = true
# Не добавлять дополнительный отступ для самих фигурных скобок.
csharp_indent_braces = false
# Не добавлять дополнительный отступ для содержимого case, если оно заключено в отдельный блок.
csharp_indent_case_contents_when_block = false

# --- ФОРМАТИРОВАНИЕ C#: ПРОБЕЛЫ ---
# Не ставить пробел после оператора приведения типа.
csharp_space_after_cast = false
# Ставить пробел после ключевых слов управляющих конструкций (if, for, while и т. п.).
csharp_space_after_keywords_in_control_flow_statements = true
# Не ставить пробелы непосредственно внутри круглых скобок.
csharp_space_between_parentheses = false
# Ставить пробел перед двоеточием в объявлении наследования.
csharp_space_before_colon_in_inheritance_clause = true
# Ставить пробел после двоеточия в объявлении наследования.
csharp_space_after_colon_in_inheritance_clause = true
# Ставить пробелы до и после бинарных операторов.
csharp_space_around_binary_operators = before_and_after
# Не ставить пробел после открывающей скобки в объявлении метода.
csharp_space_between_method_declaration_parameter_list_parentheses = false
# Не ставить пробелы внутри пустого списка параметров объявления метода.
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
# Не ставить пробел между именем метода и открывающей скобкой.
csharp_space_between_method_declaration_name_and_open_parenthesis = false
# Не ставить пробел после открывающей скобки при вызове метода.
csharp_space_between_method_call_parameter_list_parentheses = false
# Не ставить пробелы внутри пустого списка аргументов вызова метода.
csharp_space_between_method_call_empty_parameter_list_parentheses = false
# Не ставить пробел между именем вызываемого метода и открывающей скобкой.
csharp_space_between_method_call_name_and_opening_parenthesis = false
# Ставить пробел после запятой.
csharp_space_after_comma = true
# Не ставить пробел перед запятой.
csharp_space_before_comma = false
# Не ставить пробел после точки при обращении к члену.
csharp_space_after_dot = false
# Не ставить пробел перед точкой при обращении к члену.
csharp_space_before_dot = false
# Ставить пробел после точек с запятой в заголовке цикла for.
csharp_space_after_semicolon_in_for_statement = true
# Не ставить пробел перед точками с запятой в заголовке цикла for.
csharp_space_before_semicolon_in_for_statement = false
# Не добавлять пробелы вокруг частей объявлений сверх заданных правил.
csharp_space_around_declaration_statements = false
# Не ставить пробел перед открывающей квадратной скобкой.
csharp_space_before_open_square_brackets = false
# Не ставить пробелы внутри пустых квадратных скобок.
csharp_space_between_empty_square_brackets = false
# Не ставить пробелы внутри квадратных скобок.
csharp_space_between_square_brackets = false

# --- ФОРМАТИРОВАНИЕ C#: СОХРАНЕНИЕ ОДНОСТРОЧНЫХ КОНСТРУКЦИЙ ---
# Не сохранять несколько инструкций на одной строке: форматтер может переносить их.
csharp_preserve_single_line_statements = false
# Сохранять блоки кода на одной строке, если это допускается форматтером.
csharp_preserve_single_line_blocks = true

# --- ФОРМАТИРОВАНИЕ C#: ПРОСТРАНСТВА ИМЁН ---
# Предпочитать файловые пространства имён (file-scoped namespace).
csharp_style_namespace_declarations = file_scoped:warning

[Assets/Game/**/*.{cs,csx,cake,vb,vbx}]
# Ширина символа табуляции — 4 позиции.
tab_width = 4
# Использовать окончания строк CRLF.
end_of_line = crlf
# Запретить несколько пустых строк подряд. Экспериментальная настройка.
dotnet_style_allow_multiple_blank_lines_experimental = false:warning
# Разрешать размещать инструкцию сразу после закрывающей скобки блока. Экспериментальная настройка.
dotnet_style_allow_statement_immediately_after_block_experimental = true:silent
# Применять правила стиля также к коду, на который нет ссылок.
dotnet_style_prefer_rules_on_unreferenced_code = true

# --- СОГЛАШЕНИЯ ОБ ИМЕНОВАНИИ ---

[Assets/Game/**/*.{cs,csx,cake,vb,vbx}]
# Каждое правило связывает группу символов с требуемым стилем и уровнем строгости.

# Интерфейсы: имя должно начинаться с заглавной I.
dotnet_naming_rule.interface_should_be_begins_with_i.severity = error
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

# Типы (классы, структуры, интерфейсы и перечисления): PascalCase.
dotnet_naming_rule.types_should_be_pascalcase.severity = warning
dotnet_naming_rule.types_should_be_pascalcase.symbols = types
dotnet_naming_rule.types_should_be_pascalcase.style = pascalcase

# Свойства, события и методы: PascalCase.
dotnet_naming_rule.non_field_members_should_be_pascalcase.severity = warning
dotnet_naming_rule.non_field_members_should_be_pascalcase.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascalcase.style = pascalcase

# Перечисления: имя должно начинаться с заглавной E.
dotnet_naming_rule.enum_should_be_begins_with_e.severity = error
dotnet_naming_rule.enum_should_be_begins_with_e.symbols = enum
dotnet_naming_rule.enum_should_be_begins_with_e.style = begins_with_e

# Открытые и защищённые поля: camelCase.
dotnet_naming_rule.public_or_protected_field_should_be_camelcase.severity = warning
dotnet_naming_rule.public_or_protected_field_should_be_camelcase.symbols = public_or_protected_field
dotnet_naming_rule.public_or_protected_field_should_be_camelcase.style = camelcase

# Приватные и internal-поля: camelCase с начальным символом подчёркивания.
dotnet_naming_rule.private_or_internal_field_should_be_camelcasewith_.severity = warning
dotnet_naming_rule.private_or_internal_field_should_be_camelcasewith_.symbols = private_or_internal_field
dotnet_naming_rule.private_or_internal_field_should_be_camelcasewith_.style = camelcasewith_

# Свойства: PascalCase.
dotnet_naming_rule.property_should_be_pascalcase.severity = warning
dotnet_naming_rule.property_should_be_pascalcase.symbols = property
dotnet_naming_rule.property_should_be_pascalcase.style = pascalcase

# Публичные методы: PascalCase.
dotnet_naming_rule.method_should_be_pascalcase.severity = error
dotnet_naming_rule.method_should_be_pascalcase.symbols = method
dotnet_naming_rule.method_should_be_pascalcase.style = pascalcase

# Приватные методы: PascalCase.
dotnet_naming_rule.private_method_should_be_pascalcase.severity = error
dotnet_naming_rule.private_method_should_be_pascalcase.symbols = private_method
dotnet_naming_rule.private_method_should_be_pascalcase.style = pascalcase

# Абстрактные методы: PascalCase.
dotnet_naming_rule.abstract_method_should_be_pascalcase.severity = error
dotnet_naming_rule.abstract_method_should_be_pascalcase.symbols = abstract_method
dotnet_naming_rule.abstract_method_should_be_pascalcase.style = pascalcase

# Статические методы: PascalCase.
dotnet_naming_rule.static_method_should_be_pascalcase.severity = error
dotnet_naming_rule.static_method_should_be_pascalcase.symbols = static_method
dotnet_naming_rule.static_method_should_be_pascalcase.style = pascalcase

# Классы: PascalCase.
dotnet_naming_rule.class_should_be_pascalcase.severity = error
dotnet_naming_rule.class_should_be_pascalcase.symbols = class
dotnet_naming_rule.class_should_be_pascalcase.style = pascalcase

# Делегаты: PascalCase.
dotnet_naming_rule.delegate_should_be_pascalcase.severity = warning
dotnet_naming_rule.delegate_should_be_pascalcase.symbols = delegate
dotnet_naming_rule.delegate_should_be_pascalcase.style = pascalcase

# События: camelCase.
dotnet_naming_rule.event_should_be_camelcase.severity = warning
dotnet_naming_rule.event_should_be_camelcase.symbols = event
dotnet_naming_rule.event_should_be_camelcase.style = camelcase
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

# Публичные и защищённые static readonly-поля: PascalCase.
dotnet_naming_rule.public_protected_static_readonly_fields_must_be_pascal_case_rule.severity = warning
dotnet_naming_rule.public_protected_static_readonly_fields_must_be_pascal_case_rule.symbols = public_protected_static_readonly_fields_group
dotnet_naming_rule.public_protected_static_readonly_fields_must_be_pascal_case_rule.style = pascalcase
dotnet_naming_rule.parameters_rule.symbols = parameters_group
dotnet_naming_rule.parameters_rule.style = camelcase

# Параметры методов: camelCase.
dotnet_naming_rule.parameters_rule.severity = warning
dotnet_naming_rule.type_parameter_rule.symbols = type_parameter_group
dotnet_naming_rule.type_parameter_rule.style = prefix_type_parameters_with_t_style

# Параметры типов: PascalCase с префиксом T.
dotnet_naming_rule.type_parameter_rule.severity = warning

